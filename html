                    chapterLabel: "Nota 3 de 4",
                    leftQuote: "«La mejor compañía es aquella con la que el silencio nunca resulta incómodo.»",
                    heading: "Un atardecer tranquilo",
                    text: "Si tuviera que elegir un plan perfecto contigo, sería uno sencillo: ver caer la tarde sin mirar el reloj, tomarnos algo rico y platicar de cualquier tontería o de la vida entera. Contigo las cosas simples se sienten especiales, y eso no se encuentra todos los días."
                },
                {
                    chapterLabel: "Nota 4 de 4",
                    leftQuote: "«Hay personas que hacen el mundo un poquito más cálido con solo existir.»",
                    heading: "Quédate con esto",
                    text: "Solo quería recordarte lo mucho que vales y lo afortunado que me siento de tenerte cerca. No cambies nunca esa esencia tan linda que tienes. Gracias por tu tiempo, por tus risas y por ser tú. Ojalá este pequeño detalle te recuerde siempre lo especial que eres para mí."
                }
            ]
        };

        let isBookOpen = false;
        let currentPageIndex = 0;
        let typewriterTimer = null;

        /* ==========================================================
           3. INICIALIZACIÓN DE FOTOS
           ========================================================== */
        function initPhotosAndStorage() {
            try {
                const savedPhotos = localStorage.getItem('danni_book_photos_v2');
                if (savedPhotos) {
                    const parsed = JSON.parse(savedPhotos);
                    if (Array.isArray(parsed) && parsed.length === 3) {
                        photoGallery = parsed;
                    }
                } else {
                    photoGallery.forEach((item, idx) => {
                        const testImg = new Image();
                        testImg.onload = () => {
                            photoGallery[idx].src = item.fileCandidate;
                            updatePhotoDisplays();
                        };
                        testImg.src = item.fileCandidate;
                    });
                }

                const savedBook = localStorage.getItem('danni_book_data_v2');
                if (savedBook) {
                    const parsedBook = JSON.parse(savedBook);
                    bookData = Object.assign(bookData, parsedBook);
                }
            } catch (e) {
                console.warn(e);
            }
            updatePhotoDisplays();
        }

        function updatePhotoDisplays() {
            const coverImg = document.getElementById('coverMainImage');
            if (coverImg) coverImg.src = photoGallery[2].src;

            const activePhoto = photoGallery[currentPolaroidIndex];
            const leftPolaroid = document.getElementById('leftPolaroidImage');
            const captionEl = document.getElementById('polaroidCaption');
            const counterEl = document.getElementById('polaroidCounter');
            const cardEl = document.getElementById('polaroidCard');

            if (leftPolaroid) leftPolaroid.src = activePhoto.src;
            if (captionEl) captionEl.textContent = activePhoto.caption;
            if (counterEl) counterEl.textContent = `${currentPolaroidIndex + 1}/3`;
            if (cardEl) cardEl.style.transform = `rotate(${activePhoto.rotation || '-1deg'})`;

            const mobileThumb = document.getElementById('mobilePolaroidThumb');
            const mobileCap = document.getElementById('mobilePolaroidCaption');
            if (mobileThumb) mobileThumb.src = activePhoto.src;
            if (mobileCap) mobileCap.textContent = activePhoto.caption;

            for (let i = 0; i < 3; i++) {
                const prev = document.getElementById(`previewImg${i}`);
                if (prev) prev.src = photoGallery[i].src;
            }

            document.getElementById('recipientBadge').textContent = `Para ${bookData.recipient}`;
            document.getElementById('coverTitle').textContent = bookData.coverTitle;
            document.getElementById('coverSubtitle').textContent = bookData.coverSubtitle;
        }

        function cyclePolaroid(direction, event) {
            if (event) event.stopPropagation();
            currentPolaroidIndex = (currentPolaroidIndex + direction + photoGallery.length) % photoGallery.length;
            updatePhotoDisplays();
            playSoftChime();
        }

        function handlePhotoUpload(slotIndex, inputElement) {
            const file = inputElement.files && inputElement.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                photoGallery[slotIndex].src = e.target.result;
                currentPolaroidIndex = slotIndex;
                updatePhotoDisplays();
                try {
                    localStorage.setItem('danni_book_photos_v2', JSON.stringify(photoGallery));
                } catch (err) {}
                spawnLoveBurst(12);
            };
            reader.readAsDataURL(file);
        }

        /* ==========================================================
           4. CONTROL DEL LIBRO 3D
           ========================================================== */
        function handleCoverClick() {
            if (!isBookOpen) openBook();
        }

        function toggleBookState() {
            if (isBookOpen) closeBook();
            else openBook();
        }

        function openBook() {
            isBookOpen = true;
            const wrapper = document.getElementById('bookWrapper');
            wrapper.classList.remove('is-closed');
            wrapper.classList.add('is-open');

            document.getElementById('toggleBookIcon').textContent = '📕';
            document.getElementById('toggleBookText').textContent = 'Cerrar cuaderno';

            playPageTurnSound();
            spawnLoveBurst(14);

            setTimeout(() => {
                renderPage(currentPageIndex);
            }, 450);
        }

        function closeBook(event) {
            if (event) event.stopPropagation();
            isBookOpen = false;
            const wrapper = document.getElementById('bookWrapper');
            wrapper.classList.remove('is-open');
            wrapper.classList.add('is-closed');

            document.getElementById('toggleBookIcon').textContent = '📖';
            document.getElementById('toggleBookText').textContent = 'Abrir cuaderno';

            if (typewriterTimer) clearInterval(typewriterTimer);
            playPageTurnSound();
        }

        function changePage(direction) {
            const nextIndex = currentPageIndex + direction;
            if (nextIndex < 0) return;

            if (nextIndex >= bookData.pages.length) {
                spawnLoveBurst(30);
                playSoftChime();
                return;
            }

            currentPageIndex = nextIndex;
            playPageTurnSound();
            spawnLoveBurst(8);
            renderPage(currentPageIndex);
        }

        function renderPage(index) {
            const page = bookData.pages[index];
            const total = bookData.pages.length;

            currentPolaroidIndex = index % photoGallery.length;
            updatePhotoDisplays();

            document.getElementById('leftPageQuote').textContent = page.leftQuote;
            document.getElementById('chapterNumber').textContent = page.chapterLabel;
            document.getElementById('pageHeading').textContent = page.heading;

            document.getElementById('prevPageBtn').disabled = (index === 0);
            const nextBtnText = document.getElementById('nextBtnText');
            if (index === total - 1) {
                nextBtnText.textContent = "Con cariño ❤️";
            } else {
                nextBtnText.textContent = "Siguiente";
            }

            const dotsContainer = document.getElementById('pageDots');
            dotsContainer.innerHTML = '';
            for (let i = 0; i < total; i++) {
                const dot = document.createElement('button');
                dot.className = `w-2 h-2 rounded-full transition-all ${
                    i === index ? 'bg-stone-900 w-4' : 'bg-stone-400/40 hover:bg-stone-400/70'
                }`;
                dot.onclick = () => {
                    currentPageIndex = i;
                    renderPage(i);
                };
                dotsContainer.appendChild(dot);
            }

            const textEl = document.getElementById('typewriterText');
            const signatureEl = document.getElementById('pageSignature');
            signatureEl.textContent = bookData.signature;
            signatureEl.classList.remove('opacity-100');
            signatureEl.classList.add('opacity-0');

            if (typewriterTimer) clearInterval(typewriterTimer);
            textEl.textContent = '';
            textEl.classList.add('typewriter-cursor');

            let charIndex = 0;
            const fullText = page.text;

            typewriterTimer = setInterval(() => {
                if (charIndex < fullText.length) {
                    textEl.textContent += fullText.charAt(charIndex);
                    charIndex++;
                } else {
                    clearInterval(typewriterTimer);
                    textEl.classList.remove('typewriter-cursor');
                    signatureEl.classList.remove('opacity-0');
                    signatureEl.classList.add('opacity-100');
                }
            }, 26);
        }

        /* ==========================================================
           5. CAJITA DE MÚSICA ACÚSTICA CON TONE.JS (MELODÍA NOSTÁLGICA)
           ========================================================== */
        let isMusicPlaying = false;
        let musicBoxSynth = null;
        let musicPattern = null;

        async function toggleMusic() {
            try {
                await Tone.start();

                if (!musicBoxSynth) {
                    // Sintetizador calibrado para sonar idéntico a una cajita de música antigua de manivela
                    musicBoxSynth = new Tone.PolySynth(Tone.Synth, {
                        oscillator: { type: "triangle" },
                        envelope: {
                            attack: 0.005,
                            decay: 1.6,
                            sustain: 0.02,
                            release: 1.9
                        }
                    }).toDestination();
                    musicBoxSynth.volume.value = -13;

                    // Melodía tipo vals de cajita de música (dulce, lenta, humana)
                    const melodyNotes = [
                        { time: "0:0", note: "E5" },
                        { time: "0:1", note: "G5" },
                        { time: "0:2", note: "B5" },
                        { time: "1:0", note: "A5" },
                        { time: "1:1.5", note: "G5" },
                        { time: "2:0", note: "F#5" },
                        { time: "2:1", note: "D5" },
                        { time: "2:2", note: "A5" },
                        { time: "3:0", note: "G5" },
                        { time: "3:2", note: "D5" },

                        { time: "4:0", note: "E5" },
                        { time: "4:1", note: "G5" },
                        { time: "4:2", note: "C6" },
                        { time: "5:0", note: "B5" },
                        { time: "5:1.5", note: "A5" },
                        { time: "6:0", note: "G5" },
                        { time: "6:1", note: "F#5" },
                        { time: "6:2", note: "D5" },
                        { time: "7:0", note: "E5" }
                    ];

                    musicPattern = new Tone.Part((time, value) => {
                        musicBoxSynth.triggerAttackRelease(value.note, "8n", time);
                    }, melodyNotes);
                    musicPattern.loop = true;
                    musicPattern.loopEnd = "8m";
                }

                if (isMusicPlaying) {
                    Tone.Transport.stop();
                    musicPattern.stop();
                    isMusicPlaying = false;
                    document.getElementById('musicIcon').textContent = '♪';
                    document.getElementById('musicLabel').textContent = 'Cajita de música';
                } else {
                    Tone.Transport.bpm.value = 68;
                    musicPattern.start(0);
                    Tone.Transport.start();
                    isMusicPlaying = true;
                    document.getElementById('musicIcon').textContent = '🔊';
                    document.getElementById('musicLabel').textContent = 'Sonando suave';
                }
            } catch (e) {
                console.error("Audio:", e);
            }
        }

        function playPageTurnSound() {
            if (!musicBoxSynth || !isMusicPlaying) return;
            try {
                musicBoxSynth.triggerAttackRelease("B5", "16n");
            } catch (e) {}
        }

        function playSoftChime() {
            if (!musicBoxSynth || !isMusicPlaying) return;
            try {
                musicBoxSynth.triggerAttackRelease(["E5", "G5"], "16n");
            } catch (e) {}
        }

        /* ==========================================================
           6. JARDÍN DE GIRASOLES BOTÁNICOS (ARMONÍA NATURAL)
           ========================================================== */
        const FIBONACCI_SEEDS = (() => {
            const seeds = [];
            const goldenAngle = 137.507764 * (Math.PI / 180);
            const totalSeeds = 80;
            for (let i = 1; i <= totalSeeds; i++) {
                const r = 2.45 * Math.sqrt(i);
                const theta = i * goldenAngle;
                const cx = (100 + r * Math.cos(theta)).toFixed(1);
                const cy = (95 + r * Math.sin(theta)).toFixed(1);
                const radius = (i > 58 ? 1.5 : i > 28 ? 1.2 : 0.9).toFixed(2);
                const fill = i > 60 ? '#f59e0b' : (i % 3 === 0 ? '#b45309' : '#78350f');
                seeds.push(`<circle cx="${cx}" cy="${cy}" r="${radius}" fill="${fill}" />`);
            }
            return seeds.join('');
        })();

        function createBotanicalSunflowerSVG(uid, config) {
            const { scale, delay, tilt, isBackground = false } = config;

            const backPetals = Array.from({ length: 22 }, (_, i) => {
                const angle = (i * 16.3) + 7;
                return `<path d="M100,95 C91,68 92,36 100,15 C108,36 109,68 100,95 Z" fill="#b45309" opacity="0.9" transform="rotate(${angle} 100 95)"/>`;
            }).join('');

            const midPetals = Array.from({ length: 22 }, (_, i) => {
                const angle = (i * 16.3) + 3;
                return `<path d="M100,95 C89,67 91,38 100,19 C109,38 111,67 100,95 Z" fill="#d97706" opacity="0.95" transform="rotate(${angle} 100 95)"/>`;
            }).join('');

            const frontPetals = Array.from({ length: 22 }, (_, i) => {
                const angle = i * 16.3;
                return `<path d="M100,95 C91,70 93,43 100,24 C107,43 109,70 100,95 Z" fill="#f59e0b" transform="rotate(${angle} 100 95)"/>`;
            }).join('');

            const sizeClasses = isBackground ? "w-14 sm:w-18 h-24 sm:h-28" : "w-24 sm:w-32 h-40 sm:h-52";

            return `
                <div class="sunflower-wrapper flex flex-col items-center select-none"
                     style="transform: scale(${scale}) rotate(${tilt}deg);"
                     onclick="triggerSunflowerBloom(this, event)"
                     title="Girasol para Danni">
                    <div class="sunflower-stem ${delay}">
                        <svg viewBox="0 0 200 310" class="${sizeClasses} overflow-visible drop-shadow-[0_8px_16px_rgba(0,0,0,0.5)]">
                            <!-- Tallo -->
                            <path d="M100,98 C94,165 105,235 98,310" stroke="#15803d" stroke-width="10" fill="none" stroke-linecap="round"/>
                            <!-- Hoja izquierda -->
                            <path d="M97,192 C68,168 30,175 18,205 C32,232 72,236 98,210 Z" fill="#166534" stroke="#14532d" stroke-width="1.2"/>
                            <!-- Hoja derecha -->
                            <path d="M102,226 C132,202 170,208 182,238 C168,265 128,268 101,244 Z" fill="#166534" stroke="#14532d" stroke-width="1.2"/>
                            <!-- Flor con heliotropismo -->
                            <g class="sunflower-heliotrope" style="transform-origin: 100px 95px; transition: transform 0.3s ease-out;">
                                <g>${backPetals}</g>
                                <g>${midPetals}</g>
                                <g>${frontPetals}</g>
                                <circle cx="100" cy="95" r="28" fill="#381c14" stroke="#291206" stroke-width="2"/>
                                <g>${FIBONACCI_SEEDS}</g>
                            </g>
                        </svg>
                    </div>
                </div>
            `;
        }

        function buildSunflowerGarden() {
            // Jardín en arco suave (bajo en el centro para dar protagonismo al libro)
            const garden = document.getElementById('sunflowerGarden');
            const foregroundConfigs = [
                { scale: 0.95, delay: 'sway-delay-1', tilt: -5 },
                { scale: 0.80, delay: 'sway-delay-3', tilt: -3 },
                { scale: 0.62, delay: 'sway-delay-2', tilt: -2 },
                { scale: 0.44, delay: 'sway-delay-5', tilt: 1 },
                { scale: 0.36, delay: 'sway-delay-4', tilt: -1 },
                { scale: 0.32, delay: 'sway-delay-1', tilt: 0 },
                { scale: 0.36, delay: 'sway-delay-3', tilt: 1 },
                { scale: 0.44, delay: 'sway-delay-2', tilt: -1 },
                { scale: 0.62, delay: 'sway-delay-5', tilt: 2 },
                { scale: 0.80, delay: 'sway-delay-4', tilt: 3 },
                { scale: 0.95, delay: 'sway-delay-1', tilt: 5 }
            ];
            garden.innerHTML = foregroundConfigs.map((c, i) => createBotanicalSunflowerSVG(`fg-${i}`, c)).join('');

            // Laterales
            const sideFrame = document.getElementById('sideSunflowerFrame');
            if (sideFrame) {
                const leftCluster = `
                    <div class="flex items-end -space-x-8 -ml-4">
                        ${createBotanicalSunflowerSVG('side-l1', { scale: 1.05, delay: 'sway-delay-2', tilt: -4 })}
                        ${createBotanicalSunflowerSVG('side-l2', { scale: 0.85, delay: 'sway-delay-4', tilt: 4 })}
                    </div>
                `;
                const rightCluster = `
                    <div class="flex items-end -space-x-8 -mr-4">
                        ${createBotanicalSunflowerSVG('side-r1', { scale: 0.85, delay: 'sway-delay-3', tilt: -4 })}
                        ${createBotanicalSunflowerSVG('side-r2', { scale: 1.05, delay: 'sway-delay-5', tilt: 4 })}
                    </div>
                `;
                sideFrame.innerHTML = leftCluster + rightCluster;
            }

            // Horizonte lejano
            const bgHorizon = document.getElementById('backgroundSunflowerHorizon');
            if (bgHorizon) {
                const bgConfigs = Array.from({ length: 12 }, (_, i) => ({
                    scale: 0.45 + (i % 3) * 0.1,
                    delay: `sway-delay-${(i % 5) + 1}`,
                    tilt: (i % 2 === 0 ? 1 : -1) * (2 + (i % 3)),
                    isBackground: true
                }));
                bgHorizon.innerHTML = bgConfigs.map((c, i) => createBotanicalSunflowerSVG(`bg-${i}`, c)).join('');
            }
        }

        function triggerSunflowerBloom(wrapperEl, event) {
            if (event) event.stopPropagation();
            const rect = wrapperEl.getBoundingClientRect();
            spawnSunflowerPollenBurst(rect.left + rect.width / 2, rect.top + rect.height / 3, 16);
            playSoftChime();
        }

        function setupHeliotropism() {
            const updateTilt = (clientX, clientY) => {
                const normX = (clientX / window.innerWidth) - 0.5;
                const angle = normX * 14;
                const heads = document.querySelectorAll('.sunflower-heliotrope');
                heads.forEach((head) => {
                    head.style.transform = `rotate(${angle.toFixed(1)}deg)`;
                });
            };

            window.addEventListener('mousemove', (e) => updateTilt(e.clientX, e.clientY), { passive: true });
            window.addEventListener('touchmove', (e) => {
                if (e.touches && e.touches[0]) updateTilt(e.touches[0].clientX, e.touches[0].clientY);
            }, { passive: true });
        }

        /* ==========================================================
           7. SISTEMA DE PARTÍCULAS ORGÁNICAS (LUCIÉRNAGAS Y PÉTALOS)
           ========================================================== */
        const canvas = document.getElementById('ambientCanvas');
        const ctx = canvas.getContext('2d');
        let fireflies = [];
        let floatingLove = [];
        let driftingPetals = [];

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        for (let i = 0; i < 35; i++) {
            fireflies.push({
                x: Math.random() * canvas.width,
                y: Math.random() * canvas.height,
                r: Math.random() * 2 + 1,
                vx: (Math.random() - 0.5) * 0.35,
                vy: -Math.random() * 0.35 - 0.1,
                alpha: Math.random(),
                deltaAlpha: Math.random() * 0.015 + 0.005,
                hue: Math.random() > 0.4 ? 42 : 30
            });
        }

        for (let i = 0; i < 16; i++) {
            driftingPetals.push({
                x: Math.random() * canvas.width,
                y: Math.random() * canvas.height,
                vx: Math.random() * 0.5 + 0.2,
                vy: Math.random() * 0.35 + 0.15,
                size: Math.random() * 6 + 6,
                angle: Math.random() * Math.PI * 2,
                vAngle: (Math.random() - 0.5) * 0.02,
                flipPhase: Math.random() * Math.PI * 2,
                vFlip: Math.random() * 0.03 + 0.01,
                swayPhase: Math.random() * Math.PI * 2
            });
        }

        function spawnSunflowerPollenBurst(originX, originY, count = 16) {
            const symbols = ['✦', '•', '✨', '🌻'];
            for (let i = 0; i < count; i++) {
                const angle = Math.random() * Math.PI * 2;
                const speed = Math.random() * 2.8 + 1;
                floatingLove.push({
                    x: originX,
                    y: originY,
                    vx: Math.cos(angle) * speed,
                    vy: Math.sin(angle) * speed - 1.2,
                    size: Math.random() * 8 + 8,
                    alpha: 1,
                    rotation: Math.random() * Math.PI * 2,
                    vRot: (Math.random() - 0.5) * 0.04,
                    symbol: symbols[Math.floor(Math.random() * symbols.length)]
                });
            }
        }

        function spawnLoveBurst(count = 18) {
            const centerX = canvas.width / 2;
            const centerY = canvas.height / 2;
            const symbols = ['🌻', '💛', '✦', '🍂'];
            for (let i = 0; i < count; i++) {
                floatingLove.push({
                    x: centerX + (Math.random() - 0.5) * 200,
                    y: centerY + (Math.random() - 0.5) * 140,
                    vx: (Math.random() - 0.5) * 2.5,
                    vy: -Math.random() * 2.2 - 0.8,
                    size: Math.random() * 10 + 10,
                    alpha: 1,
                    rotation: Math.random() * Math.PI * 2,
                    vRot: (Math.random() - 0.5) * 0.03,
                    symbol: symbols[Math.floor(Math.random() * symbols.length)]
                });
            }
        }

        function drawGoldenPetal(ctx, p) {
            ctx.save();
            ctx.translate(p.x, p.y);
            ctx.rotate(p.angle);
            const flipScale = Math.cos(p.flipPhase);
            ctx.scale(1, Math.max(0.2, Math.abs(flipScale)));

            ctx.fillStyle = 'rgba(234, 140, 30, 0.75)';
            ctx.beginPath();
            ctx.moveTo(-p.size, 0);
            ctx.quadraticCurveTo(0, -p.size * 0.5, p.size, 0);
            ctx.quadraticCurveTo(0, p.size * 0.5, -p.size, 0);
            ctx.closePath();
            ctx.fill();
            ctx.restore();
        }

        function animateCanvas() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Luciérnagas
            for (let f of fireflies) {
                f.x += f.vx;
                f.y += f.vy;
                f.alpha += f.deltaAlpha;

                if (f.alpha > 0.95 || f.alpha < 0.15) f.deltaAlpha *= -1;
                if (f.y < -10) f.y = canvas.height + 10;
                if (f.x < -10) f.x = canvas.width + 10;
                if (f.x > canvas.width + 10) f.x = -10;

                ctx.save();
                ctx.beginPath();
                const grad = ctx.createRadialGradient(f.x, f.y, 0, f.x, f.y, f.r * 3.5);
                grad.addColorStop(0, `hsla(${f.hue}, 100%, 80%, ${f.alpha})`);
                grad.addColorStop(1, `hsla(${f.hue}, 100%, 50%, 0)`);
                ctx.fillStyle = grad;
                ctx.arc(f.x, f.y, f.r * 3.5, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }

            // Pétalos suaves
            for (let p of driftingPetals) {
                p.swayPhase += 0.015;
                p.x += p.vx + Math.sin(p.swayPhase) * 0.3;
                p.y += p.vy + Math.cos(p.swayPhase * 0.6) * 0.15;
                p.angle += p.vAngle;
                p.flipPhase += p.vFlip;

                if (p.x > canvas.width + 25) p.x = -25;
                if (p.y > canvas.height + 25) {
                    p.y = -20;
                    p.x = Math.random() * canvas.width;
                }
                drawGoldenPetal(ctx, p);
            }

            // Partículas de afecto
            for (let i = floatingLove.length - 1; i >= 0; i--) {
                const p = floatingLove[i];
                p.x += p.vx;
                p.y += p.vy;
                p.rotation += p.vRot;
                p.alpha -= 0.009;

                if (p.alpha <= 0) {
                    floatingLove.splice(i, 1);
                    continue;
                }

                ctx.save();
                ctx.globalAlpha = Math.max(0, p.alpha);
                ctx.translate(p.x, p.y);
                ctx.rotate(p.rotation);
                ctx.font = `${p.size}px serif`;
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText(p.symbol, 0, 0);
                ctx.restore();
            }

            requestAnimationFrame(animateCanvas);
        }

        /* ==========================================================
           8. MODAL DE PERSONALIZACIÓN
           ========================================================== */
        function openCustomizeModal(focusSection = 'text') {
            document.getElementById('inputRecipient').value = bookData.recipient;
            document.getElementById('inputCoverTitle').value = bookData.coverSubtitle;
            document.getElementById('inputPage1').value = bookData.pages[0].text;
            document.getElementById('inputPage2').value = bookData.pages[1].text;
            document.getElementById('inputPage3').value = bookData.pages[2].text;
            document.getElementById('inputPage4').value = bookData.pages[3].text;
            document.getElementById('inputSignature').value = bookData.signature;

            document.getElementById('inputCaption0').value = photoGallery[0].caption;
            document.getElementById('inputCaption1').value = photoGallery[1].caption;
            document.getElementById('inputCaption2').value = photoGallery[2].caption;
            updatePhotoDisplays();

            const modal = document.getElementById('customizeModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');

            if (focusSection === 'photos') {
                const sec = document.getElementById('photoUploadSection');
                if (sec) sec.scrollIntoView({ behavior: 'smooth' });
            }
        }

        function closeCustomizeModal() {
            const modal = document.getElementById('customizeModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function saveCustomDedication() {
            const recipient = document.getElementById('inputRecipient').value.trim();
            const subtitle = document.getElementById('inputCoverTitle').value.trim();
            const p1 = document.getElementById('inputPage1').value.trim();
            const p2 = document.getElementById('inputPage2').value.trim();
            const p3 = document.getElementById('inputPage3').value.trim();
            const p4 = document.getElementById('inputPage4').value.trim();
            const sig = document.getElementById('inputSignature').value.trim();

            const cap0 = document.getElementById('inputCaption0').value.trim();
            const cap1 = document.getElementById('inputCaption1').value.trim();
            const cap2 = document.getElementById('inputCaption2').value.trim();

            if (cap0) photoGallery[0].caption = cap0;
            if (cap1) photoGallery[1].caption = cap1;
            if (cap2) photoGallery[2].caption = cap2;

            if (recipient) {
                bookData.recipient = recipient;
                bookData.coverTitle = recipient;
            }
            if (subtitle) bookData.coverSubtitle = subtitle;
            if (p1) bookData.pages[0].text = p1;
            if (p2) bookData.pages[1].text = p2;
            if (p3) bookData.pages[2].text = p3;
            if (p4) bookData.pages[3].text = p4;
            if (sig) bookData.signature = sig;

            try {
                localStorage.setItem('danni_book_photos_v2', JSON.stringify(photoGallery));
                localStorage.setItem('danni_book_data_v2', JSON.stringify(bookData));
            } catch (e) {}

            updatePhotoDisplays();
            closeCustomizeModal();

            if (!isBookOpen) openBook();
            else {
                renderPage(currentPageIndex);
                spawnLoveBurst(20);
            }
        }

        window.onload = function() {
            initPhotosAndStorage();
            buildSunflowerGarden();
            setupHeliotropism();
            renderPage(0);
            animateCanvas();
        };
    </script>
