        let photoGallery = [
            {
                fileCandidate: "WhatsApp Image 2026-10-08 at 23.57.08.jpeg",
                src: artBotanicalPress,
                caption: "Esa sonrisa tan tuya ✨",
                rotation: "-1.5deg"
